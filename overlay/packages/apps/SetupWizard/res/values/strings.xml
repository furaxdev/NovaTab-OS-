<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlay de branding pour l'app SetupWizard (assistant de premier démarrage) de LineageOS.

  ⚠️ IMPORTANT : les noms de ressources ci-dessous (setup_welcome_message, etc.) correspondent
  à ceux utilisés dans packages/apps/SetupWizard au moment de la rédaction de ce fichier, sur
  la branche cm-14.1. Ils peuvent différer selon la version exacte du SetupWizard synchronisée.

  Avant de builder : après ton premier `repo sync` (voir scripts/build.sh), vérifie les vrais
  noms de ressources dans :
    <WORKDIR>/packages/apps/SetupWizard/res/values/strings.xml
  et ajuste ce fichier en conséquence si les noms ont changé. Un overlay qui référence une
  ressource inexistante est simplement ignoré par le build (pas d'erreur bloquante), donc si
  ton texte custom n'apparaît pas après un flash, c'est probablement la première chose à vérifier.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="setup_welcome_message">Bienvenue sur NovaTab OS</string>
    <string name="setup_welcome_message_short">NovaTab OS</string>
</resources>

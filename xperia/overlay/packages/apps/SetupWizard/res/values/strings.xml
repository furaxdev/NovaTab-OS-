<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlay de branding pour SetupWizard et les apps LineageOS affichant "LineageOS"
  (SetupWizard, LineageParts/Paramètres > À propos).

  Les noms exacts varient selon la build — si un texte "LineageOS" persiste après le patch,
  inspecter l'APK avec : apktool d <apk> -o decompiled && grep -rn "LineageOS" decompiled/res/
  puis ajouter l'entrée correspondante ici.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- SetupWizard -->
    <string name="setup_welcome">Bienvenue sur FuraxOS</string>
    <string name="os_name">FuraxOS</string>

    <!-- LineageParts / À propos du téléphone -->
    <string name="lineage_version">Version FuraxOS</string>
    <string name="lineage_version_default">FuraxOS-1.0</string>
    <string name="mod_version">Version FuraxOS</string>
    <string name="about_summary">FuraxOS</string>
</resources>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  roomservice.xml pour le SM-T530 (matissewifi, famille "matisse").

  À placer dans .repo/local_manifests/roomservice.xml de ta source tree LineageOS 14.1
  (scripts/build.sh le fait automatiquement).

  IMPORTANT : les URLs ci-dessous pointent vers les forks communautaires trouvés au moment
  de la rédaction de ce manifest (org GitHub "matissewifi", qui maintient le device tree pour
  ce modèle précis). Le support de ce device étant ancien et non-officiel, vérifie que ces
  dépôts existent toujours ET que la branche `cm-14.1` y est bien présente avant de lancer le
  sync (voir docs/DEVICE.md) — si ce n'est pas le cas, remplace le <project> par le fork/la
  branche active que tu auras trouvé (les dépôts community ont aussi des branches
  lineage-16.0/17.1/18.1 plus récentes selon les archives trouvées).
-->
<manifest>
  <project name="matissewifi/android_device_samsung_matissewifi"
           path="device/samsung/matissewifi"
           remote="github"
           revision="cm-14.1" />

  <project name="matissewifi/android_device_samsung_matisse-common"
           path="device/samsung/matisse-common"
           remote="github"
           revision="cm-14.1" />

  <project name="LineageOS/android_kernel_samsung_smdk3470"
           path="kernel/samsung/smdk3470"
           remote="github"
           revision="cm-14.1" />

  <!--
    Les blobs vendor propriétaires (Wi-Fi, GPS, GPU) ne doivent PAS être récupérés depuis un
    dépôt tiers par défaut : extrais-les toi-même depuis ta tablette avec
    device/samsung/matissewifi/extract-files.sh une fois le device tree en place, ou utilise
    ton propre dépôt vendor si tu en as un.
  -->
  <!--
  <project name="TON_COMPTE/proprietary_vendor_samsung_matissewifi"
           path="vendor/samsung/matissewifi"
           remote="github"
           revision="cm-14.1" />
  -->
</manifest>
